pipeline {
    agent any

    environment {
        IMAGE_NAME = "health-api"
        IMAGE_TAG  = "latest"
        // Define the project path for reuse
        PROJECT_PATH = "projects/08-health-api-jenkins"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Pulling code from the Source of Truth...'
            }
        }

	stage('Docker Build') {
            steps {
                dir("${PROJECT_PATH}") {
                    echo "Building Docker Image inside Minikube Environment..."
                    sh '''
                        # Manually pointing to the certificates we migrated for Jenkins
                        export DOCKER_TLS_VERIFY="1"
                        export DOCKER_HOST="tcp://127.0.0.1:62101"
                        export DOCKER_CERT_PATH="/var/lib/jenkins/.minikube/certs"
                        
                        docker build -t health-api:latest .
                    '''
                }
            }
        }

        stage('Kubernetes Deployment') {
            steps {
                dir("${PROJECT_PATH}") {
                    echo 'Deploying to Minikube using Flat Manifests...'
                    sh "kubectl apply -f k8s_deployment.yaml"
                    sh "kubectl apply -f k8s_service.yaml"
                }
            }
        }

        stage('Verification') {
            steps {
                echo 'Checking Deployment Status...'
                sh "kubectl get pods -l app=health-api"
            }
        }
    }
}
