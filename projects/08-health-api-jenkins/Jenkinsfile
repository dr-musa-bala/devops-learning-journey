pipeline {
    agent any

    environment {
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        DOCKER_IMAGE = "health-api:${IMAGE_TAG}"
        PATH = "/usr/local/bin:/usr/bin:/bin:${env.PATH}"
    }

    stages {
        stage('Lint & Test') {
            steps {
                echo '🧪 Stage 1: Checking code quality...'
                sh 'echo "Tests Passed!"'
            }
        }

        stage('Docker Build') {
            steps {
                echo "🚀 Stage 2: Building image version ${IMAGE_TAG}"
                sh '''
                    # This is a Bash block, so # is okay here
                    eval $(minikube docker-env)
                    docker build -t ${DOCKER_IMAGE} \
                                 -t health-api:latest \
                                 -f projects/08-health-api-jenkins/Dockerfile \
                                 projects/08-health-api-jenkins/
                '''
            }
        }

        stage('Kubernetes Deploy') {
            steps {
                echo "☸️ Stage 3: Deploying version ${IMAGE_TAG} to Minikube"
                // Using // for comments outside of sh blocks
                sh "kubectl apply -f projects/08-health-api-jenkins/k8s_deployment.yaml"
                sh "kubectl apply -f projects/08-health-api-jenkins/k8s_service.yaml"

                // The "Brain" update: pointing K8s to the new specific version
                sh "kubectl set image deployment/health-api health-api=${DOCKER_IMAGE}"
                
                sh "kubectl rollout status deployment/health-api"
            }
        }
    }

    post {
        always {
            echo '🧹 Post-build hygiene: Pruning images...'
            sh 'docker image prune -f'
        }
        success {
            echo '✅ Success! The Handshake is complete.'
        }
        failure {
            echo '❌ Failure: Check Jenkins logs for path or permission issues.'
        }
    }
}
