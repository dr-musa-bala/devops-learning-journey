pipeline {
    agent any

    environment {
        // Use the build number so we can rollback if needed
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        DOCKER_IMAGE = "health-api:${IMAGE_TAG}"
    }

    stages {
        stage('Lint & Test') {
            steps {
                echo '🧪 Running code quality checks...'
                // If this is a Python/Node API, run your linter here
                // Example: sh 'pylint **/*.py' or 'npm test'
                sh 'echo "Tests Passed!"' 
            }
        }

        stage('Docker Build') {
            steps {
                echo "🚀 Building Image Version: ${IMAGE_TAG}"
                sh '''
                    eval $(minikube docker-env)
                    docker build -t ${DOCKER_IMAGE} -t health-api:latest -f projects/08-health-api-jenkins/Dockerfile projects/08-health-api-jenkins/
                '''
            }
        }

        stage('Kubernetes Deploy') {
            steps {
                echo "☸️ Updating Deployment to version ${IMAGE_TAG}..."
                // We use 'set image' to update the pod without changing the YAML file
                sh "kubectl apply -f k8s_deployment.yaml"
                sh "kubectl set image deployment/health-api health-api=health-api:${IMAGE_TAG}"
                
                sh "kubectl apply -f k8s_service.yaml"
                sh "kubectl rollout status deployment/health-api"
            }
        }
    }

    post {
        success {
            // Since we know your Slack webhook works, you can eventually add a 
            // Slack notification step here using the Jenkins Slack Plugin!
            echo '✅ Deployment Successful!'
        }
        failure {
            echo '❌ Pipeline Failed. Investigation required.'
        }
    }
}
