    agent any

    environment {
        // Replace with your actual Docker Hub ID
        DOCKER_HUB_USER = 'musabalaaudu' 
        APP_NAME = 'health-api'
        // Tagging images with build numbers ensures traceability
        IMAGE_TAG = "${env.BUILD_NUMBER}" 
        K8S_NAMESPACE = 'monitoring'
    }

    stages {
        stage('🧹 Cleanup Workspace') {
            steps {
                cleanWs()
                echo 'Workspace cleaned and ready.'
            }
        }

        stage('🛠️ Build Docker Image') {
            steps {
                script {
                    echo "Building Docker Image: ${DOCKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG}"
                    sh "docker build -t ${DOCKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG} ."
                    // Also tag as latest for convenience
                    sh "docker tag ${DOpipeline {
    agent any

    environment {
        // Replace with your actual Docker Hub ID
        DOCKER_HUB_USER = 'musabalaaudu' 
        APP_NAME = 'health-api'
        // Tagging images with build numbers ensures traceability
        IMAGE_TAG = "${env.BUILD_NUMBER}" 
        K8S_NAMESPACE = 'monitoring'
    }

    stages {
        stage('🧹 Cleanup Workspace') {
            steps {
                cleanWs()
                echo 'Workspace cleaned and ready.'
            }
        }

        stage('🛠️ Build Docker Image') {
            steps {
                script {
                    echo "Building Docker Image: ${DOCKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG}"
                    sh "docker build -t ${DOCKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG} ."
                    // Also tag as latest for convenience
                    sh "docker tag ${DOCKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG} ${DOCKER_HUB_USER}/${APP_NAME}:latest"
                }
            }
        }

        stage('📤 Push to Docker Hub') {
            steps {
                // IMPORTANT: You must create 'docker-hub-creds' in Jenkins Credentials first!
                withCredentials([usernamePassword(credentialsId: 'docker-hub-creds', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh "echo $PASS | docker login -u $USER --password-stdin"
                    sh "docker push ${DOCKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG}"
                    sh "docker push ${DOCKER_HUB_USER}/${APP_NAME}:latest"
                }
            }
        }

        stage('🚀 Deploy to Kubernetes') {
            steps {
                script {
                    echo "Deploying to Kubernetes Namespace: ${K8S_NAMESPACE}"
                    // This updates the container image in your existing deployment
                    sh "kubectl set image deployment/health-app health-app=${DOCKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG} -n ${K8S_NAMESPACE}"
                    
                    // Verifies the rollout is successful
                    sh "kubectl rollout status deployment/health-app -n ${K8S_NAMESPACE}"
                }
            }
        }

        stage('🧪 Smoke Test') {
            steps {
                script {
                    echo "Verifying application availability..."
                    // We test the internal service name to ensure the cluster networking is up
                    sh "kubectl exec -n ingress-nginx \$(kubectl get pods -n ingress-nginx -l app.kubernetes.io/name=ingress-nginx -o jsonpath='{.items[0].metadata.name}') -- curl -s http://health-app-service.monitoring.svc.cluster.local/health"
                }
            }
        }
    }

    post {
        success {
            echo "✅ Success: Health API version ${IMAGE_TAG} is live at health.kaduna.hub!"
        }
        failure {
            echo '❌ Failure: Check Jenkins logs for path or permission issues.'
        }
    }
}CKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG} ${DOCKER_HUB_USER}/${APP_NAME}:latest"
