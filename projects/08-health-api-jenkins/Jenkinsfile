pipeline {
    agent any

    environment {
        DOCKER_HUB_USER = 'musabalaaudu'
        APP_NAME = 'health-api'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        K8S_NAMESPACE = 'monitoring'
        // This links to the 'ID' you created in Jenkins Credentials
        DOCKER_HUB_CREDS = credentials('docker-hub-credentials')
	MINIKUBE_IP = "192.168.49.2"
	K8S_SERVER = "https://${MINIKUBE_IP}:8443"
	KUBECONFIG = "/home/dr-musa/.kube/config" 
    }

    stages {
        stage('🛠️ Build Docker Image') {
            steps {
                // Ensure we are in the correct project directory
                dir('projects/08-health-api-jenkins') {
                    sh "docker build -t ${DOCKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG} ."
                }
            }
        }

        stage('🚀 Push to Docker Hub') {
            steps {
                // This is the missing piece! It logs you in so you can push.
                sh "echo \$DOCKER_HUB_CREDS_PSW | docker login -u \$DOCKER_HUB_CREDS_USR --password-stdin"
                sh "docker push ${DOCKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG}"
            }
        }

        stage('☸️ Deploy to Kubernetes') {
            steps {
                dir('projects/08-health-api-jenkins') {
        	    script {           
	 // This replaces the image tag in your YAML with the current Build Number
                    sh "sed -i 's|image:.*|image: docker.io/${DOCKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG}|g' k8s_deployment.yaml"
                    sh "kubectl apply -f k8s_deployment.yaml -n ${K8S_NAMESPACE} --validate=false"
                }
            }
        }
    }
    
    post {
        always {
            // Good practice: logout so your credentials aren't left on the Jenkins runner
            sh "docker logout"
        }
    }
}
