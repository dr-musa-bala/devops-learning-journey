pipeline {
    agent any

    environment {
        // Defining the image name to keep the script clean
        DOCKER_IMAGE = "health-api:latest"
    }

    stages {
        stage('Checkout') {
            steps {
                // Pulling the latest code from your GitHub repository
                git 'https://github.com/dr-musa/devops-learning-journey.git'
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Building the Docker Image...'
                // Building with the new Port 80 configuration
                sh "docker build -t ${DOCKER_IMAGE} -f projects/08-health-api-jenkins/Dockerfile projects/08-health-api-jenkins/"
            }
        }

        stage('Kubernetes Deploy') {
            steps {
                echo 'Deploying to Minikube...'
                // Applying the Dynamic Config (env variables) and Service (Port 80)
                sh "kubectl apply -f projects/08-health-api-jenkins/k8s_deployment.yaml"
                sh "kubectl apply -f projects/08-health-api-jenkins/k8s_service.yaml"
                
                echo 'Waiting for rollout to complete...'
                sh "kubectl rollout status deployment/health-api"
            }
        }
    }

    // --- PHASE 10: INFRASTRUCTURE HYGIENE ---
    post {
        always {
            echo '🧹 Performing post-build cleanup...'
            // This removes "dangling" image layers to reclaim that 4GB+ of space
            sh 'docker image prune -f'
        }
        success {
            echo '✅ Pipeline completed successfully. Environment is Green & Lean!'
        }
        failure {
            echo '❌ Pipeline failed. Check the console logs for errors.'
        }
    }
}
