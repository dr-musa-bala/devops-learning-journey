pipeline {
    agent any

    environment {
        DOCKER_HUB_USER = 'musabalaaudu' 
        APP_NAME = 'health-api' // Matched to your K8s deployment name
        IMAGE_TAG = "${env.BUILD_NUMBER}" 
        K8S_NAMESPACE = 'monitoring' // Correct namespace
    }

    stages {
        stage('🛠️ Build Docker Image') {
            steps {
                dir('projects/08-health-api-jenkins') {
                    script {
                        echo "Building version ${IMAGE_TAG}..."
                        sh "docker build -t ${DOCKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG} ."
                        sh "docker tag ${DOCKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG} ${DOCKER_HUB_USER}/${APP_NAME}:latest"
                    }
                }
            }
        }

        stage('📤 Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-hub-creds', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    script {
                        sh "echo $PASS | docker login -u $USER --password-stdin"
                        sh "docker push ${DOCKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG}"
                        sh "docker push ${DOCKER_HUB_USER}/${APP_NAME}:latest"
                    }
                }
            }
        }

        stage('🚀 Deploy to Kubernetes') {
            steps {
                script {
                    echo "Updating K8s deployment '${APP_NAME}' in namespace '${K8S_NAMESPACE}'"
                    // Corrected command: deployment/health-api
                    sh "kubectl set image deployment/${APP_NAME} ${APP_NAME}=${DOCKER_HUB_USER}/${APP_NAME}:${IMAGE_TAG} -n ${K8S_NAMESPACE}"
                    sh "kubectl rollout status deployment/${APP_NAME} -n ${K8S_NAMESPACE}"
                }
            }
        }
    }

    post {
        success {
            echo "✅ SUCCESS! Project 08 is fully automated and live."
        }
        failure {
            echo "❌ Still failing? Check if the container name inside the pod is also 'health-api'."
        }
    }
}
